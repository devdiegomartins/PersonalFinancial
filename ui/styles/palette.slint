// Paleta de Cores - Material Design 3
// Cores Primárias
export struct Primary {
    // Tons principais
    primary-0: #000000;
    primary-10: #21005d;
    primary-20: #381e72;
    primary-30: #4f378b;
    primary-40: #6750a4;
    primary-50: #7f67be;
    primary-60: #9a82db;
    primary-70: #b69df8;
    primary-80: #d0bcff;
    primary-90: #eaddff;
    primary-95: #f6edff;
    primary-99: #fffbfe;
    primary-100: #ffffff;
    
    // Cores de superfície com tonalidade primária
    surface-dim: #ded8e1;
    surface-bright: #fffbfe;
    surface-container-lowest: #ffffff;
    surface-container-low: #f7f2fa;
    surface-container: #f3edf7;
    surface-container-high: #ece6f0;
    surface-container-highest: #e6e0e9;
}

// Cores Secundárias
export struct Secondary {
    // Tons secundários
    secondary-0: #000000;
    secondary-10: #1d192b;
    secondary-20: #332d41;
    secondary-30: #4a4458;
    secondary-40: #625b71;
    secondary-50: #7a7289;
    secondary-60: #958da5;
    secondary-70: #b0a7c0;
    secondary-80: #ccc2dc;
    secondary-90: #e8def8;
    secondary-95: #f6edff;
    secondary-99: #fffbfe;
    secondary-100: #ffffff;
}

// Cores Terciárias
export struct Tertiary {
    // Tons terciários
    tertiary-0: #000000;
    tertiary-10: #31111d;
    tertiary-20: #492532;
    tertiary-30: #633b48;
    tertiary-40: #7d5260;
    tertiary-50: #986977;
    tertiary-60: #b58392;
    tertiary-70: #d29da8;
    tertiary-80: #efb8c8;
    tertiary-90: #ffd8e4;
    tertiary-95: #ffecf1;
    tertiary-99: #fffbfe;
    tertiary-100: #ffffff;
}

// Cores de Erro
export struct Error {
    // Tons de erro
    error-0: #000000;
    error-10: #410e0b;
    error-20: #601410;
    error-30: #8c1d18;
    error-40: #b3261e;
    error-50: #dc362e;
    error-60: #e46962;
    error-70: #ec928e;
    error-80: #f2b8b5;
    error-90: #f9dedc;
    error-95: #fceeee;
    error-99: #fffbf9;
    error-100: #ffffff;
}

// Cores Neutras
export struct Neutral {
    // Tons neutros
    neutral-0: #000000;
    neutral-10: #1c1b1f;
    neutral-20: #313033;
    neutral-30: #484649;
    neutral-40: #605d62;
    neutral-50: #787579;
    neutral-60: #939094;
    neutral-70: #aeaaae;
    neutral-80: #c9c5ca;
    neutral-90: #e6e1e5;
    neutral-95: #f4eff4;
    neutral-99: #fffbfe;
    neutral-100: #ffffff;
    
    // Variantes neutras
    neutral-variant-0: #000000;
    neutral-variant-10: #1d1a22;
    neutral-variant-20: #322f37;
    neutral-variant-30: #49454f;
    neutral-variant-40: #605d66;
    neutral-variant-50: #79747e;
    neutral-variant-60: #938f99;
    neutral-variant-70: #aea9b4;
    neutral-variant-80: #cac4d0;
    neutral-variant-90: #e7e0ec;
    neutral-variant-95: #f5eefa;
    neutral-variant-99: #fffbfe;
    neutral-variant-100: #ffffff;
}

// Cores de Superfície
export struct Surface {
    // Superfícies principais
    surface: #fffbfe;
    surface-variant: #e7e0ec;
    surface-container: #f3edf7;
    surface-container-high: #ece6f0;
    surface-container-highest: #e6e0e9;
    surface-container-low: #f7f2fa;
    surface-container-lowest: #ffffff;
    surface-dim: #ded8e1;
    surface-bright: #fffbfe;
    
    // Superfícies com tonalidade
    surface-tint: #6750a4;
    surface-tint-color: #6750a4;
}

// Cores de Estado
export struct State {
    // Estados de hover
    on-surface-hover: #1c1b1f;
    on-surface-container-hover: #1c1b1f;
    
    // Estados de foco
    on-surface-focus: #1c1b1f;
    on-surface-container-focus: #1c1b1f;
    
    // Estados de pressão
    on-surface-pressed: #1c1b1f;
    on-surface-container-pressed: #1c1b1f;
}

// Cores de Texto
export struct Text {
    // Texto sobre superfícies
    on-surface: #1c1b1f;
    on-surface-variant: #49454f;
    on-primary: #ffffff;
    on-secondary: #ffffff;
    on-tertiary: #ffffff;
    on-error: #ffffff;
    
    // Texto sobre containers
    on-surface-container: #1c1b1f;
    on-primary-container: #21005d;
    on-secondary-container: #1d192b;
    on-tertiary-container: #31111d;
    on-error-container: #410e0b;
}

// Cores de Outline
export struct Outline {
    outline: #79747e;
    outline-variant: #cac4d0;
}

// Cores de Sombra
export struct Shadow {
    shadow: #000000;
    scrim: #000000;
}

// Cores de Elevação
export struct Elevation {
    // Níveis de elevação
    elevation-0: #000000;
    elevation-1: #000000;
    elevation-2: #000000;
    elevation-3: #000000;
    elevation-4: #000000;
    elevation-5: #000000;
}

// Cores de Feedback
export struct Feedback {
    // Sucesso
    success: #4caf50;
    on-success: #ffffff;
    success-container: #e8f5e8;
    on-success-container: #1b5e20;
    
    // Aviso
    warning: #ff9800;
    on-warning: #ffffff;
    warning-container: #fff3e0;
    on-warning-container: #e65100;
    
    // Informação
    info: #2196f3;
    on-info: #ffffff;
    info-container: #e3f2fd;
    on-info-container: #0d47a1;
}

// Cores de Acesso
export struct Accessibility {
    // Alto contraste
    high-contrast-on-surface: #000000;
    high-contrast-on-primary: #000000;
    high-contrast-on-secondary: #000000;
    high-contrast-on-tertiary: #000000;
    high-contrast-on-error: #000000;
}

// Estrutura principal da paleta
export struct MaterialPalette {
    primary: Primary;
    secondary: Secondary;
    tertiary: Tertiary;
    error: Error;
    neutral: Neutral;
    surface: Surface;
    state: State;
    text: Text;
    outline: Outline;
    shadow: Shadow;
    elevation: Elevation;
    feedback: Feedback;
    accessibility: Accessibility;
}

// Instância global da paleta
export global material-palette: MaterialPalette = {
    primary: Primary,
    secondary: Secondary,
    tertiary: Tertiary,
    error: Error,
    neutral: Neutral,
    surface: Surface,
    state: State,
    text: Text,
    outline: Outline,
    shadow: Shadow,
    elevation: Elevation,
    feedback: Feedback,
    accessibility: Accessibility,
};
