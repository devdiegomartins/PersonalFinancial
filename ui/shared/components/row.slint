// ===== COMPONENTES RESPONSIVOS =====

// Row responsivo para mobile
export component RowMobile inherits Row {
    width: 100%;
    padding: design-system.spacing.page-padding;
    gap: design-system.spacing.md;
    wrap: true;
}

// Row responsivo para tablet
export component RowTablet inherits Row {
