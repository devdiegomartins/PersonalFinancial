// ===== COMPONENTES DE TEXTO COM ESTADOS =====

// Texto com estados de interação
export component InteractiveText inherits Text {
    color: get-current-palette().text.on-surface;
    
    // Estados de hover
    property hover-color: brush = get-current-palette().primary.primary-40;
    property is-hovered: bool = false;
    
    // Estados de foco
    property focus-color: brush = get-current-palette().primary.primary-40;
    property is-focused: bool = false;
    
    // Estados de pressão
    property pressed-color: brush = get-current-palette().primary.primary-30;
    property is-pressed: bool = false;
    
    // Estados de desabilitado
    property disabled-color: brush = get-current-palette().text.on-surface;
    property is-disabled: bool = false;
    
    // Aplicar cor baseada no estado
    color: {
        if (self.is-disabled) {
            self.disabled-color
        } else if (self.is-pressed) {
            self.pressed-color
        } else if (self.is-focused) {
            self.focus-color
        } else if (self.is-hovered) {
            self.hover-color
        } else {
            get-current-palette().text.on-surface
        }
    }
}

// ===== COMPONENTES DE TEXTO ESPECIALIZADOS =====

// Texto de link
export component LinkText inherits InteractiveText {
    color: get-current-palette().primary.primary-40;
    text-decoration: underline;
    
    // Cores específicas para links
    hover-color: get-current-palette().primary.primary-30;
    focus-color: get-current-palette().primary.primary-50;
    pressed-color: get-current-palette().primary.primary-20;
    disabled-color: get-current-palette().text.on-surface;
}

// Texto de erro
export component ErrorText inherits Text {
    color: get-current-palette().error.error-40;
    font-size: design-system.typography.body-small.font-size;
    font-weight: design-system.typography.body-small.font-weight;
}

// Texto de sucesso
export component SuccessText inherits Text {
    color: get-current-palette().feedback.success;
    font-size: design-system.typography.body-small.font-size;
    font-weight: design-system.typography.body-small.font-weight;
}

// Texto de aviso
