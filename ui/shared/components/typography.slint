// ===== COMPONENTES DE TEXTO COM ALINHAMENTO =====

// Texto centralizado
export component CenteredText inherits Text {
    horizontal-alignment: TextHorizontalAlignment.Center;
}

// Texto alinhado à direita
export component RightAlignedText inherits Text {
    horizontal-alignment: TextHorizontalAlignment.Right;
}

// Texto justificado
export component JustifiedText inherits Text {
    horizontal-alignment: TextHorizontalAlignment.Justify;
}

// ===== COMPONENTES DE TEXTO COM TRUNCAMENTO =====

// Texto com ellipsis
export component TruncatedText inherits Text {
    overflow: TextOverflow.Ellipsis;
    single-line: true;
}

// Texto com quebra de linha
export component WrappedText inherits Text {
    overflow: TextOverflow.Wrap;
    single-line: false;
}

