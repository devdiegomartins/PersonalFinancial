{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Personal Finance",
	"version": "0.1.0",
	"identifier": "com.personalfinance.app",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Personal Finance",
				"width": 600,
				"height": 240,
				"center": true,
				"decorations": false,
				"alwaysOnTop": true,
				"resizable": false,
				"closable": false,
				"titleBarStyle": "Visible"
			}
		],
		"security": {
			"csp": null
		}
	},
	"plugins": {
		"fs": {
			"requireLiteralLeadingDot": false
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
