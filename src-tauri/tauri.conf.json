{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Personal Financial",
  "version": "0.1.0",
  "identifier": "com.personalfinancial.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "Personal Financial - Splash",
        "width": 800,
        "height": 800,
        "center": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "auth",
        "title": "Personal Financial - Autenticação",
        "width": 800,
        "height": 600,
        "center": true,
        "visible": false
      },
      {
        "label": "first-access",
        "title": "Personal Financial - Primeiro Acesso",
        "width": 800,
        "height": 600,
        "center": true,
        "visible": false
      },
      {
        "label": "dashboard",
        "title": "Personal Financial - Dashboard",
        "width": 1200,
        "height": 800,
        "center": true,
        "visible": false,
        "minWidth": 800,
        "minHeight": 600
      },
      {
        "label": "error",
        "title": "Personal Financial - Erro",
        "width": 600,
        "height": 400,
        "center": true,
        "visible": false,
        "alwaysOnTop": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}