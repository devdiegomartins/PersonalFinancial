{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Personal Financial",
    "version": "0.1.0",
    "identifier": "com.personal.financial.app",
    "build": {
        "beforeDevCommand": "bun run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "bun run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "visible": false,
                "url": "templates/dashboard.html"
            },
            {
                "label": "splash",
                "url": "templates/splash.html",
                "decorations": false,
                "resizable": false,
                "width": 500.0,
                "height": 140.0,
                "center": true
            },
            {
                "label": "initialization_setup",
                "url": "templates/initialization_setup.html",
                "visible": false
            },
            {
                "label": "debug_error",
                "url": "templates/debug_error.html",
                "visible": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "msi",
            "dmg",
            "deb"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}